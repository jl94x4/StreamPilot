# Required — at least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Server
PORT=2121
BIND_HOST=0.0.0.0

# Container identity
# Match PUID/PGID to the owner of config and any writable media files.
# Native Media Automation state/work lives under CONFIG_DIR/media-automation.
PUID=1000
PGID=1000
# Optional container-path overrides (normally leave these under the config mount).
# MEDIA_AUTOMATION_CONFIG_DIR=/app/config/media-automation
# MEDIA_AUTOMATION_WORK_DIR=/app/config/media-automation/work

# Optional host group IDs when passing /dev/dri for Intel/AMD acceleration.
# Discover them with: getent group video; getent group render
# VIDEO_GID=44
# RENDER_GID=109
# Optional NVIDIA NVENC (requires NVIDIA Container Toolkit + runtime: nvidia):
# NVIDIA_VISIBLE_DEVICES=all
# NVIDIA_DRIVER_CAPABILITIES=video,compute,utility

# Public URL shown in emails/links (no trailing slash)
# PUBLIC_BASE_URL=https://portal.example.com
# For subpath hosting behind a reverse proxy, include the path in PUBLIC_BASE_URL
# or set BASE_PATH directly:
# PUBLIC_BASE_URL=https://plex.example.com/portal
# BASE_PATH=/portal

# Set true ONLY when the portal is served over HTTPS (reverse proxy).
# Must be false (or unset) for plain HTTP LAN access, e.g. http://192.168.x.x:2121
# If PUBLIC_BASE_URL is https://..., cookies are marked Secure automatically.
# FORCE_SECURE_COOKIES=false

# Allow Sonarr/Radarr/Tautulli URLs on private/LAN IPs (common in Docker/homelab)
# ALLOW_PRIVATE_INTEGRATION_URLS=true

# Optional override for server-side Seerr API calls when the public reverse-proxy URL is not reachable from Docker
# REQUEST_APP_INTERNAL_URL=http://jellyseerr:5055

# Optional one-time setup token for remote first-time configuration
# SETUP_TOKEN=

# Optional fixed Plex OAuth client id (auto-generated on first run if unset)
# CLIENT_ID=

# Override runtime data directory (default: ./config inside the container)
# CONFIG_DIR=/app/config

# Collexions is bundled in the portal Docker image — enable in Settings → Collexions.
# Optional: override the embedded worker listen port (default 15755)
# COLLEXIONS_EMBEDDED_PORT=15755

# Spotify Sync: Settings → Spotify Sync writes config/spotify-to-plex.env (Compose env_file) and supervisord.conf.
# Restart the spotify-to-plex container after credential or schedule mode changes.
