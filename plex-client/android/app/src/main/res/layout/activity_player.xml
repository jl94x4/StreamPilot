<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:keep_content_on_player_reset="true"
        app:show_buffering="never"
        app:shutter_background_color="#000000"
        app:surface_type="surface_view"
        app:use_controller="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <ImageView
        android:id="@+id/player_art"
        android:layout_width="324dp"
        android:layout_height="324dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:focusable="false"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/player_buffering"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/player_accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/player_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#E6111827"
        android:paddingHorizontal="22dp"
        android:paddingVertical="14dp"
        android:textColor="@color/player_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/player_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="25dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/player_menu_sheet"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/player_text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="25dp"
        android:paddingTop="18dp"
        android:paddingEnd="90dp"
        android:paddingBottom="25dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="58dp">

            <ImageView
                android:id="@+id/player_logo"
                android:layout_width="wrap_content"
                android:layout_height="58dp"
                android:layout_gravity="center_vertical|start"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:focusable="false"
                android:maxWidth="468dp"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/player_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:ellipsize="end"
                android:letterSpacing="0.01"
                android:maxLines="2"
                android:shadowColor="#80000000"
                android:shadowRadius="6"
                android:textColor="@color/player_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/player_close"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:background="@drawable/player_control_icon_bg"
            android:contentDescription="@string/player_close"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="true"
            android:minWidth="33dp"
            android:minHeight="33dp"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_player_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/player_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/player_clock_pill"
        android:clickable="false"
        android:focusable="false"
        android:fontFamily="sans-serif-medium"
        android:fontFeatureSettings="tnum"
        android:importantForAccessibility="no"
        android:letterSpacing="0.02"
        android:minWidth="50dp"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:text="00:00"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/player_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingTop="18dp"
        android:paddingEnd="25dp"
        android:paddingBottom="25dp">

        <LinearLayout
            android:id="@+id/player_skip_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:paddingBottom="11dp"
            android:visibility="gone">

            <Button
                android:id="@+id/player_skip_intro"
                style="@style/PlayerChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="@string/player_skip_intro"
                android:visibility="gone" />

            <Button
                android:id="@+id/player_skip_credits"
                style="@style/PlayerChipButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="@string/player_skip_credits"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/player_seek_back"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/player_control_icon_bg"
                android:contentDescription="@string/player_seek_back"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:nextFocusRight="@id/player_play_pause"
                android:nextFocusDown="@id/player_quality"
                android:minWidth="35dp"
                android:minHeight="35dp"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_player_replay_10" />

            <ImageButton
                android:id="@+id/player_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="7dp"
                android:background="@drawable/player_control_icon_bg"
                android:contentDescription="@string/player_play"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:focusedByDefault="true"
                android:nextFocusLeft="@id/player_seek_back"
                android:nextFocusRight="@id/player_seek_fwd"
                android:nextFocusDown="@id/player_quality"
                android:minWidth="40dp"
                android:minHeight="40dp"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_player_play" />

            <ImageButton
                android:id="@+id/player_seek_fwd"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/player_control_icon_bg"
                android:contentDescription="@string/player_seek_fwd"
                android:defaultFocusHighlightEnabled="false"
                android:focusable="true"
                android:nextFocusLeft="@id/player_play_pause"
                android:nextFocusDown="@id/player_quality"
                android:minWidth="35dp"
                android:minHeight="35dp"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_player_forward_10" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/player_actions_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:clipToPadding="false"
            android:fadingEdgeLength="22dp"
            android:fillViewport="true"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/player_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/player_quality"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:nextFocusUp="@id/player_play_pause"
                    android:nextFocusRight="@id/player_audio"
                    android:text="@string/player_quality" />

                <Button
                    android:id="@+id/player_audio"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:nextFocusUp="@id/player_play_pause"
                    android:nextFocusLeft="@id/player_quality"
                    android:nextFocusRight="@id/player_subs"
                    android:text="@string/player_audio" />

                <Button
                    android:id="@+id/player_subs"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:nextFocusUp="@id/player_play_pause"
                    android:nextFocusLeft="@id/player_audio"
                    android:nextFocusRight="@id/player_version"
                    android:text="@string/player_subs" />

                <Button
                    android:id="@+id/player_version"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:nextFocusUp="@id/player_play_pause"
                    android:nextFocusLeft="@id/player_subs"
                    android:nextFocusRight="@id/player_speed"
                    android:text="@string/player_version" />

                <Button
                    android:id="@+id/player_speed"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/player_speed" />

                <Button
                    android:id="@+id/player_zoom"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:nextFocusUp="@id/player_play_pause"
                    android:text="@string/player_zoom" />

                <Button
                    android:id="@+id/player_delay"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:nextFocusUp="@id/player_play_pause"
                    android:text="@string/player_delay" />

                <Button
                    android:id="@+id/player_repeat"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:nextFocusUp="@id/player_play_pause"
                    android:text="@string/player_repeat" />

                <Button
                    android:id="@+id/player_sleep"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/player_sleep" />

                <Button
                    android:id="@+id/player_external"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="@string/player_external" />

                <Button
                    android:id="@+id/player_chapters"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:nextFocusUp="@id/player_play_pause"
                    android:text="@string/player_chapters"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/player_pip"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/player_pip"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/player_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="0:00 / 0:00"
                android:textColor="@color/player_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/player_speed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingEnd="4dp"
                android:text="1.0×"
                android:textColor="@color/player_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/player_seek_preview"
            android:layout_width="173dp"
            android:layout_height="97dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="7dp"
            android:adjustViewBounds="true"
            android:background="#CC000000"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/player_seek"
            style="@style/PlayerSeekBar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="2dp"
            android:background="@null"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false"
            android:duplicateParentState="false"
            android:focusable="true"
            android:max="1000"
            android:progressDrawable="@drawable/player_seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/player_seek_thumb"
            android:thumbOffset="9dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_up_next"
        android:layout_width="304dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/player_menu_sheet"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/player_up_next_art"
            android:layout_width="match_parent"
            android:layout_height="171dp"
            android:background="#33000000"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/player_up_next_kicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/player_up_next"
                android:textAllCaps="true"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_up_next_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/player_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_up_next_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/player_up_next_credits"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:focusable="true"
                    android:text="@string/player_watch_credits" />

                <Button
                    android:id="@+id/player_up_next_play"
                    style="@style/PlayerChipButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:text="@string/player_play_now" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/player_menu_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/player_menu_sheet"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/player_menu_sheet"
            android:elevation="18dp"
            android:minWidth="260dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/player_menu_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/player_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/player_menu_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/player_menu_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
