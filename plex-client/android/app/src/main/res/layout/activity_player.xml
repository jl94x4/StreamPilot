<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:keep_content_on_player_reset="true"
        app:show_buffering="never"
        app:shutter_background_color="#000000"
        app:surface_type="surface_view"
        app:use_controller="false"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- SurfaceView punches through to the episode page until the first frame. -->
    <View
        android:id="@+id/player_surface_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/player_art"
        android:layout_width="324dp"
        android:layout_height="324dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:focusable="false"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/player_buffering"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/player_accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/player_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#E6111827"
        android:paddingHorizontal="22dp"
        android:paddingVertical="14dp"
        android:textColor="@color/player_text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_burn_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/player_menu_sheet"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="20dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/player_accent" />

        <TextView
            android:id="@+id/player_burn_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:text="@string/player_burning_subs"
            android:textColor="@color/player_text_primary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/player_burn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:focusable="true"
            android:text="@string/player_burning_subs_cancel" />
    </LinearLayout>

    <TextView
        android:id="@+id/player_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="25dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/player_menu_sheet"
        android:fontFamily="monospace"
        android:lineSpacingExtra="3dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/player_text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_scrim_top"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingTop="18dp"
        android:paddingEnd="110dp"
        android:paddingBottom="18dp">

        <!-- Logo/title column — meta centers under the clearlogo width. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="58dp">

                <ImageView
                    android:id="@+id/player_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="58dp"
                    android:layout_gravity="center_horizontal"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:focusable="false"
                    android:maxWidth="468dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/player_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:ellipsize="end"
                    android:letterSpacing="0.01"
                    android:maxWidth="520dp"
                    android:maxLines="2"
                    android:shadowColor="#80000000"
                    android:shadowRadius="6"
                    android:textAlignment="center"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/player_text_primary"
                    android:textSize="22sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/player_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxWidth="468dp"
                android:maxLines="3"
                android:shadowColor="#80000000"
                android:shadowRadius="4"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"
                android:textColor="@color/player_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Clock + circular close stacked top-right; X centered under the time. -->
    <LinearLayout
        android:id="@+id/player_top_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/player_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/player_clock_pill"
            android:clickable="false"
            android:focusable="false"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:letterSpacing="0.02"
            android:minWidth="72dp"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="12:00 AM"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Hidden: Back closes the player. Kept for the click handler / older references. -->
        <ImageButton
            android:id="@+id/player_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/player_close_btn_bg"
            android:contentDescription="@string/player_close"
            android:defaultFocusHighlightEnabled="false"
            android:focusable="false"
            android:visibility="gone"
            android:minWidth="30dp"
            android:minHeight="30dp"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_player_close"
            android:tint="@color/player_close_icon" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_scrim_bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingTop="10dp"
        android:paddingEnd="25dp"
        android:paddingBottom="@dimen/player_bottom_pad">

        <!-- Hidden chip strip kept for findViewById / settings tree value helpers -->
        <HorizontalScrollView
            android:id="@+id/player_actions_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/player_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/player_quality" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_quality" />
                <Button android:id="@+id/player_audio" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_audio" />
                <Button android:id="@+id/player_subs" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_subs" />
                <Button android:id="@+id/player_version" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_version" />
                <Button android:id="@+id/player_speed" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_speed" />
                <Button android:id="@+id/player_zoom" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_zoom" />
                <Button android:id="@+id/player_delay" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_delay" />
                <Button android:id="@+id/player_repeat" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_repeat" />
                <Button android:id="@+id/player_sleep" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_sleep" />
                <Button android:id="@+id/player_external" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_external" />
                <Button android:id="@+id/player_chapters" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_chapters" />
                <Button android:id="@+id/player_pip" style="@style/PlayerChipButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/player_pip" />
            </LinearLayout>
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/player_seek_back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/player_seek_back"
            android:src="@drawable/ic_player_replay_10"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/player_seek_fwd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/player_seek_fwd"
            android:src="@drawable/ic_player_forward_10"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/player_seek_preview"
            android:layout_width="173dp"
            android:layout_height="97dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="7dp"
            android:adjustViewBounds="true"
            android:background="#CC000000"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/player_seek_flash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="2dp"
            android:background="@drawable/player_clock_pill"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="@color/player_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/player_seek"
            style="@style/PlayerSeekBar"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@null"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="false"
            android:duplicateParentState="false"
            android:focusable="true"
            android:max="1000"
            android:nextFocusDown="@id/player_play_pause"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:progressDrawable="@drawable/player_seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/player_seek_thumb"
            android:thumbOffset="14dp" />

        <!-- Not clipped: a focused transport button grows (player_focus_scale) past its row. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/player_prev_episode"
                    android:layout_width="@dimen/player_transport_size"
                    android:layout_height="@dimen/player_transport_size"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/player_control_icon_bg"
                    android:stateListAnimator="@animator/player_focus_scale"
                    android:tint="@color/player_transport_icon"
                    android:contentDescription="@string/player_previous_episode"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:nextFocusRight="@id/player_play_pause"
                    android:nextFocusUp="@id/player_seek"
                    android:minWidth="@dimen/player_transport_size"
                    android:minHeight="@dimen/player_transport_size"
                    android:padding="@dimen/player_transport_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_player_previous"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/player_play_pause"
                    android:layout_width="@dimen/player_transport_play_size"
                    android:layout_height="@dimen/player_transport_play_size"
                    android:background="@drawable/player_control_icon_bg"
                    android:stateListAnimator="@animator/player_focus_scale"
                    android:tint="@color/player_transport_icon"
                    android:contentDescription="@string/player_play"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:focusedByDefault="true"
                    android:nextFocusLeft="@id/player_prev_episode"
                    android:nextFocusRight="@id/player_next_episode"
                    android:nextFocusUp="@id/player_seek"
                    android:minWidth="@dimen/player_transport_play_size"
                    android:minHeight="@dimen/player_transport_play_size"
                    android:padding="@dimen/player_transport_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_player_play" />

                <ImageButton
                    android:id="@+id/player_next_episode"
                    android:layout_width="@dimen/player_transport_size"
                    android:layout_height="@dimen/player_transport_size"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/player_control_icon_bg"
                    android:stateListAnimator="@animator/player_focus_scale"
                    android:tint="@color/player_transport_icon"
                    android:contentDescription="@string/player_next_episode"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:nextFocusLeft="@id/player_play_pause"
                    android:nextFocusRight="@id/player_settings"
                    android:nextFocusUp="@id/player_seek"
                    android:minWidth="@dimen/player_transport_size"
                    android:minHeight="@dimen/player_transport_size"
                    android:padding="@dimen/player_transport_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_player_next"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/player_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFeatureSettings="tnum"
                    android:text="0:00"
                    android:textColor="@color/player_text_primary"
                    android:textSize="14sp" />

                <!-- How far ahead playback is buffered ("42s buffered"); the seek bar's buffer band is
                     too short to see on a long film (the player holds well under a minute). -->
                <TextView
                    android:id="@+id/player_buffer_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/player_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/player_speed_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="1.0×"
                    android:textColor="@color/player_accent"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Delivery + resolution badges, centred together on the transport row. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_mode_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/player_clock_pill"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textAllCaps="true"
                    android:textColor="@color/player_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/player_resolution_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/player_clock_pill"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textAllCaps="true"
                    android:textColor="@color/player_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/player_ends_at"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/player_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/player_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFeatureSettings="tnum"
                    android:text="-0:00"
                    android:textColor="@color/player_text_primary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/player_settings"
                    android:layout_width="@dimen/player_transport_size"
                    android:layout_height="@dimen/player_transport_size"
                    android:background="@drawable/player_control_icon_bg"
                    android:stateListAnimator="@animator/player_focus_scale"
                    android:tint="@color/player_transport_icon"
                    android:contentDescription="@string/player_settings"
                    android:defaultFocusHighlightEnabled="false"
                    android:focusable="true"
                    android:nextFocusLeft="@id/player_play_pause"
                    android:nextFocusUp="@id/player_seek"
                    android:minWidth="@dimen/player_transport_size"
                    android:minHeight="@dimen/player_transport_size"
                    android:padding="@dimen/player_transport_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_player_settings" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Outside chrome so Skip Intro/Credits can show with OSD hidden. -->
    <LinearLayout
        android:id="@+id/player_skip_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="96dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/player_skip_intro"
            style="@style/PlayerContextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/player_skip_intro"
            android:visibility="gone" />

        <Button
            android:id="@+id/player_skip_credits"
            style="@style/PlayerContextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/player_skip_credits"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/player_up_next"
        android:layout_width="304dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/player_context_sheet"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/player_up_next_art"
            android:layout_width="match_parent"
            android:layout_height="171dp"
            android:background="#33000000"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/player_up_next_kicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/player_up_next"
                android:textAllCaps="true"
                android:textColor="@color/player_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_up_next_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/player_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/player_up_next_countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/player_up_next_credits"
                    style="@style/PlayerContextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:focusable="true"
                    android:nextFocusLeft="@id/player_up_next_credits"
                    android:nextFocusRight="@id/player_up_next_play"
                    android:nextFocusUp="@id/player_up_next_credits"
                    android:nextFocusDown="@id/player_up_next_credits"
                    android:text="@string/player_watch_credits" />

                <Button
                    android:id="@+id/player_up_next_play"
                    style="@style/PlayerContextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:nextFocusLeft="@id/player_up_next_credits"
                    android:nextFocusRight="@id/player_up_next_play"
                    android:nextFocusUp="@id/player_up_next_play"
                    android:nextFocusDown="@id/player_up_next_play"
                    android:text="@string/player_play_now" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/player_menu_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/player_menu_sheet"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/player_context_sheet"
            android:elevation="0dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/player_menu_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:ellipsize="end"
                android:letterSpacing="-0.01"
                android:maxLines="2"
                android:textColor="@color/player_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ScrollView
                android:id="@+id/player_menu_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/player_menu_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
