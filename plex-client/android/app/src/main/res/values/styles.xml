<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>


    <!-- Flat field + small centered mark. Theme.SplashScreen's icon plate is a dark box on TV. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">@color/splash_background</item>
    </style>

    <style name="PlayerTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">@color/player_accent</item>
        <item name="colorAccent">@color/player_accent</item>
        <item name="alertDialogTheme">@style/PlayerDialogTheme</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
    </style>

    <style name="PlayerSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:background">@null</item>
        <item name="android:splitTrack">false</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:thumbOffset">9dp</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="tickMark">@null</item>
    </style>

    <style name="PlayerDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/player_accent</item>
        <item name="android:background">#1A2030</item>
        <item name="android:textColorPrimary">@color/player_text_primary</item>
        <item name="android:textColor">@color/player_text_primary</item>
        <item name="android:windowMinWidthMajor">56%</item>
        <item name="android:windowMinWidthMinor">72%</item>
        <item name="android:colorControlHighlight">#40F59E0B</item>
        <item name="android:listSelector">@drawable/player_dialog_item</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/player_dialog_item</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>

    <style name="PlayerChipButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/player_chip_btn</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/player_text_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:focusable">true</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PlayerMenuRow" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/player_menu_row</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/player_text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
    </style>
</resources>