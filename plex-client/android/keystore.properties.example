# Copy to keystore.properties (gitignored) and fill in. Used by `npm run build:apk:release`.
# Keep the .jks and these passwords backed up: without them no update installs over
# a build signed with this key — every device would need an uninstall first.
storeFile=C:/Users/YOU/.android/smp-release.jks
storePassword=
keyAlias=smp
keyPassword=
